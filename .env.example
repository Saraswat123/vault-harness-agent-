# No key = scripted offline model (deterministic; proves plumbing, not model quality).
# Put real keys in .env (gitignored). Never paste keys into chat.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM_PROVIDER=groq        # force one provider; default chains openrouter -> groq
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006   # opt-in tracing (see /trace)
# LLM_TIMEOUT_S=90          # per-attempt HTTP timeout in seconds; invalid or <=0 falls back to 90
# AGENT_KERNEL=off          # run WITHOUT the kernel (halt/ledger/budget/post-checks). Default is on and fails closed.
# AGENT_KIT_SRC=~/agent-kit # where agent_kernel.py lives
